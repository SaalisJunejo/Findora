# Supabase project credentials (create a free project at https://supabase.com).
# Copy this file to .env.local and fill in real values — never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by API routes (e.g. /api/create-demo-account).
# Never expose this key to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=
